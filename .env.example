# Free API key for the AI Coach's move commentary (Gemini, via Google AI
# Studio: https://aistudio.google.com/apikey). Copy this file to
# .env.local and fill in your own key - .env* is gitignored, so it never
# gets committed.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Auth -----------------------------------------------------------------

# Postgres connection string (e.g. a free Neon or Vercel Postgres project).
# Provision the database yourself and paste its connection string here,
# then run `npx prisma migrate dev` to create the tables.
DATABASE_URL=

# Session/cookie encryption secret. Generate with `npx auth secret`
# or `openssl rand -base64 32`.
AUTH_SECRET=

# Google OAuth client - Google Cloud Console > APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application.
# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Lichess OAuth - a PUBLIC client (Authorization Code + PKCE, no secret).
# Optional: sign-in works without registering an app at all. Set this only
# to pin a specific client_id (e.g. after registering at
# https://lichess.org/account/oauth/app). Defaults to "chessapp-coach".
# Scopes requested: email:read, preference:read, study:read, puzzle:read.
AUTH_LICHESS_ID=

# --- Player-behaviour model (ml/service) -----------------------------------

# Base URL of the ml/service FastAPI instance (see ml/README.md). Leave
# unset in dev if you're not running the service - /api/player-profile
# just 503s instead of crashing.
PLAYERMODEL_SERVICE_URL=
# Must match the service's own SERVICE_TOKEN env var, if it set one.
PLAYERMODEL_SERVICE_TOKEN=
